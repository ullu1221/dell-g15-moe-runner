# ==============================================================================
# Dell G15 MoE Runner Configuration
# Tuned for Qwen3.6-35B-A3B on RTX 3050 (6GB VRAM) + 16GB DDR5 System RAM
# Incorporates Community-Proven Low-VRAM & Speculative Decoding Optimizations
# ==============================================================================

# Model and Multimodal Projector paths
MODEL_PATH="${SCRIPT_DIR}/models/model.gguf"
MMPROJ_PATH="${SCRIPT_DIR}/models/mmproj.gguf"

# Server network binding
HOST="127.0.0.1"
PORT="8080"

# Core Memory & Layer Offload Architecture
CONTEXT_SIZE="8192"       # Context window (8192 tokens)
N_GPU_LAYERS="99"         # Offload all attention & dense layers to RTX 3050 CUDA
N_CPU_MOE="36"            # 36 expert layers on CPU RAM, 4 full layers on GPU (optimal sweet spot)
MOE_CACHE_MIB="1024"      # 1024 MiB hot-expert VRAM cache for fast VRAM hit rate

# CPU Core Topology Tuning (Dell G15 i5-13450HX: 6 P-Cores + 4 E-Cores = 16 Threads)
THREADS="6"               # Dedicated 6 physical Raptor Lake P-Cores for token generation
THREADS_BATCH="12"        # 12 threads for parallel batch prompt prefill (~500+ tok/s)

# Batch & Context Acceleration
BATCH_SIZE="2048"         # Batch processing size
UBATCH_SIZE="2048"        # Physical micro-batch size
FLASH_ATTN="on"           # Enable FlashAttention to minimize memory footprint
CACHE_TYPE_K="q8_0"       # 8-bit quantized Key cache
CACHE_TYPE_V="q8_0"       # 8-bit quantized Value cache
CACHE_REUSE="256"         # Min chunk size to reuse from KV cache for instant multi-turn replies
NO_MMPROJ_OFFLOAD="true"  # Keep vision model on CPU to reserve VRAM for KV and hot experts
IMAGE_MIN_TOKENS="1024"   # Vision grounding accuracy floor

# Speculative Decoding (Self-Contained N-Gram Draft Engine)
# Drastically accelerates generation speed without needing external draft models
SPEC_TYPE="ngram-mod"
SPEC_NGRAM_MATCH="24"
SPEC_NGRAM_MIN="12"
SPEC_NGRAM_MAX="48"

# Reasoning & Thought Stream Settings
REASONING_FORMAT="deepseek"
REASONING_PRESERVE="true"

# Community-Proven Qwen 3.5/3.6 Sampling Profile
TEMPERATURE="0.6"
TOP_P="0.95"
TOP_K="20"
MIN_P="0.05"

# Advanced DMA & CUDA Acceleration (Fable MoE Optimizations)
export GGML_CUDA_REGISTER_HOST="1"       # DMA page-locks mmap DDR5 expert weights to PCIe bus
export GGML_SCHED_PREFETCH_EXPERTS="1"   # Overlaps compute with async CUDA stream weight prefetching
